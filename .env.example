# Copy this file to .env and replace local-only values as needed.
COMPOSE_PROJECT_NAME=c0ntr0l
APP_ENV=development
LOG_LEVEL=INFO

# API and dashboard
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL exposed from Docker to the host
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=c0ntr0l
POSTGRES_USER=c0ntr0l
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://c0ntr0l:replace-with-a-local-password@localhost:5432/c0ntr0l

# Redis exposed from Docker to the host
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Local providers
MOCK_PROVIDER_URL=http://localhost:9000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Hackathon-safe defaults
CONTROL_PROJECT_API_KEY=replace-with-a-project-key
CONTROL_SECRET_KEY=replace-with-a-random-secret
STORE_PROMPTS_AND_RESPONSES=false
ENABLE_CROSS_PROVIDER_HANDOFF=false
