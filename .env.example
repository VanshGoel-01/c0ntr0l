# Copy this file to .env and replace local-only values as needed.
COMPOSE_PROJECT_NAME=c0ntr0l
APP_ENV=development
LOG_LEVEL=INFO

# API and dashboard
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:8000
CONTROL_API_URL=http://localhost:8000

# PostgreSQL exposed from Docker to the host
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=c0ntr0l
POSTGRES_USER=c0ntr0l
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+asyncpg://c0ntr0l:replace-with-a-local-password@localhost:5432/c0ntr0l

# Redis exposed from Docker to the host
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
EVENT_STREAM_MAX_EVENTS=1000
EVENT_STREAM_BLOCK_MILLISECONDS=15000

# Local providers
PROVIDER_BASE_URL=http://localhost:8002
MOCK_PROVIDER_BASE_URL=http://localhost:8002
PROVIDER_TIMEOUT_SECONDS=10
RECOVERY_MAX_TOKENS=128
DEFAULT_CONTEXT_WINDOW_TOKENS=8192
MOCK_CONTEXT_WINDOW_TOKENS=8192
CONTEXT_SAFETY_MARGIN_TOKENS=256
CONTEXT_WARNING_UTILIZATION=0.85
MOCK_PROVIDER_TIMEOUT_DELAY_SECONDS=5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MODEL=qwen2.5:0.5b

# Hackathon-safe defaults
API_KEY_PEPPER=replace-with-a-long-random-secret
ALLOW_DEMO_SCENARIOS=true
STORE_PROMPTS_AND_RESPONSES=false
ENABLE_CROSS_PROVIDER_HANDOFF=false
